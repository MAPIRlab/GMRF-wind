<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gmrf_wind_mapping</name>
  <version>0.0.0</version>
  <description>A lightweight, training-free, physics-informed **2D indoor airflow field estimation** using Gaussian Markov Random Fields (GMRF)</description>
  <maintainer email="jgmonroy@uma.es">Javier Monroy</maintainer>

  <license>GPLv3</license>
  <author>Javier Monroy</author>  

  <buildtool_depend>ament_cmake</buildtool_depend>
    
  <!-- Dependencies needed to compile this package. -->
  <build_depend>roscpp</build_depend>
  <build_depend>gmrf_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>  
  <build_depend>sensor_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>olfaction_msgs</build_depend>
  <build_depend>image_transport</build_depend>
  <build_depend>opencv2</build_depend>
  <build_depend>eigen</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
